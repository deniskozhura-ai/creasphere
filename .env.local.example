# CreaSphere Environment Variables
# Copy this file to .env.local and fill in your secure credentials

# 1. Admin Authentication (REQUIRED FOR PRODUCTION)
# Set a strong, unique password for the administrator panel
ADMIN_PASSWORD=change_this_to_a_strong_password_in_production

# 2. Supabase Database & Auth (Optional for local demo, Required for full production persistence)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# 3. Production Site URL
NEXT_PUBLIC_SITE_URL=https://creasphere-shop.netlify.app
